---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, plans, pricingNote, faqs } from '../data/site';

const title = `Pricing - ${site.name}`;
const description =
  'Stock4 pricing: a one-off setup fee plus a monthly company subscription and a small per-user charge. Every plan includes the full feature set on web and mobile. Indicative pricing - contact us for a tailored quote.';

// Re-use the two pricing-related FAQs at the foot of the page.
const pricingFaqs = faqs.filter((f) => /cost|started|choose|one app/i.test(f.q));
---

<Base title={title} description={description}>
  <!-- ============ HERO ============ -->
  <section class="border-b border-ink-200">
    <div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8 py-16 md:py-20">
      <p class="text-sm font-medium uppercase tracking-wider text-brand-600">Pricing</p>
      <h1 class="display mt-3 text-4xl md:text-5xl text-brand-950 max-w-3xl">
        Simple pricing, the whole feature set.
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-ink-600 leading-relaxed">
        One company subscription covers your trade app on web and mobile - every feature included.
        You pay a one-off setup fee to get your suppliers and stock loaded, then a monthly fee plus
        a small charge per user as your team grows.
      </p>
    </div>
  </section>

  <!-- ============ PLANS ============ -->
  <section class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8 py-16 md:py-20">
    <div class="grid gap-6 lg:grid-cols-3">
      {plans.map((p) => (
        <div
          class={`relative flex flex-col rounded-3xl border bg-white p-7 ${p.highlight ? 'border-brand-500 shadow-xl ring-1 ring-brand-500' : 'border-ink-200'}`}
        >
          {p.highlight && (
            <span class="absolute -top-3 left-7 rounded-full bg-brand-800 px-3 py-1 text-xs font-semibold text-white">
              Most popular
            </span>
          )}
          <h2 class="text-xl font-semibold text-ink-900">{p.name}</h2>
          <p class="mt-1 text-sm font-medium text-brand-600">{p.users}</p>
          <p class="mt-3 text-sm text-ink-600 leading-relaxed">{p.blurb}</p>

          <div class="mt-6 border-t border-ink-200 pt-6">
            <div class="flex items-baseline gap-1">
              <span class="text-4xl font-bold tracking-tight text-ink-900">{p.monthly}</span>
              <span class="text-ink-500">/month</span>
            </div>
            <p class="mt-1 text-sm text-ink-500">
              + {p.perUser} per user · {p.setup} one-off setup
            </p>
          </div>

          <ul class="mt-6 space-y-3 flex-1">
            {p.points.map((pt) => (
              <li class="flex items-start gap-3 text-sm text-ink-700">
                <span class="mt-0.5 text-brand-700"><Icon name="check-circle" class="h-5 w-5" /></span>
                <span>{pt}</span>
              </li>
            ))}
          </ul>

          <a
            href="/contact/"
            class={`mt-7 inline-flex justify-center rounded-xl px-5 py-3 font-semibold transition-colors ${p.highlight ? 'bg-brand-800 text-white hover:bg-brand-900' : 'border border-ink-300 text-ink-800 hover:border-brand-400 hover:text-brand-700'}`}
          >
            Get started
          </a>
        </div>
      ))}
    </div>

    <p class="mt-8 max-w-3xl text-sm text-ink-500 leading-relaxed">{pricingNote}</p>
  </section>

  <!-- ============ INCLUDED IN EVERY PLAN ============ -->
  <section class="border-t border-ink-200 bg-ink-50">
    <div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8 py-16 md:py-20">
      <h2 class="display text-3xl md:text-4xl text-brand-950">In every plan.</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { icon: 'qrcode', t: 'Barcode & quick-entry stock takes' },
          { icon: 'cart-plus', t: 'Ordering from stock takes' },
          { icon: 'tag', t: 'Supplier pricing & comparison' },
          { icon: 'mobile', t: 'Web portal + iOS & Android app' },
          { icon: 'sync', t: 'Live data across office, store & van' },
          { icon: 'shield', t: 'Team access with roles' },
        ].map((i) => (
          <div class="flex items-center gap-3 rounded-xl border border-ink-200 bg-white p-4">
            <span class="inline-flex size-10 items-center justify-center rounded-lg bg-brand-100 text-brand-800">
              <Icon name={i.icon as any} class="h-5 w-5" />
            </span>
            <span class="text-sm font-medium text-ink-800">{i.t}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PRICING FAQ ============ -->
  <section class="mx-auto max-w-3xl px-5 sm:px-6 lg:px-8 py-16 md:py-20">
    <h2 class="display text-3xl md:text-4xl text-brand-950">Pricing questions.</h2>
    <div class="mt-8 divide-y divide-ink-200 border-t border-ink-200">
      {pricingFaqs.map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-medium text-ink-900">
            {f.q}
            <span class="text-brand-500 transition-transform group-open:rotate-45 text-2xl leading-none">+</span>
          </summary>
          <p class="mt-3 text-ink-600 leading-relaxed">{f.a}</p>
        </details>
      ))}
    </div>
    <div class="mt-10">
      <a href="/contact/" class="inline-block rounded-xl bg-brand-800 px-6 py-3 font-semibold text-white hover:bg-brand-900 transition-colors">
        Talk to us about a quote &rarr;
      </a>
    </div>
  </section>
</Base>
