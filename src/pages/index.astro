---
import Base from '../layouts/Base.astro';
import TradeCard from '../components/TradeCard.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Icon from '../components/Icon.astro';
import { site, trades, features, steps, faqs } from '../data/site';

const title = `${site.name} — ${site.tagline}`;
const description =
  'Stock4 is stock control built for the trade: barcode stock takes, ordering, supplier price comparison and van checks. One platform, four apps — Glazing, Building, Plumbing and Electrics — on web and mobile.';

// Show the six headline features on the homepage; the rest live on /features/.
const homeFeatures = features.slice(0, 6);

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  description,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'iOS, Android, Web',
  publisher: {
    '@type': 'Organization',
    name: site.studio,
    alternateName: site.company,
    url: site.url,
  },
  offers: {
    '@type': 'Offer',
    price: '39',
    priceCurrency: 'GBP',
    description: 'Company subscription from £39/month plus a one-off setup fee.',
  },
};
---

<Base title={title} description={description}>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden border-b border-ink-200">
    <div class="absolute -top-32 -right-24 h-96 w-96 rounded-full bg-brand-200/50 blur-3xl -z-10"></div>
    <div class="absolute -bottom-40 -left-32 h-[28rem] w-[28rem] rounded-full bg-brand-100 blur-3xl -z-10"></div>

    <div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8 py-16 md:py-24">
      <div class="max-w-3xl">
        <p class="text-sm font-medium uppercase tracking-wider text-brand-600">
          Stock control for the trade
        </p>
        <h1 class="display mt-4 text-4xl sm:text-5xl md:text-6xl text-brand-950">
          Stock takes, ordering and stock control <span class="text-brand-500">in one place.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-ink-600 leading-relaxed">
          Stock4 puts your whole stock operation on one platform — count with a barcode, reorder
          from the best supplier price, and keep control across every site, store and van. One
          proven system, delivered as the app built for your trade, on web and mobile.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#trades" class="rounded-xl bg-brand-800 px-5 py-3 font-medium text-white shadow-sm hover:bg-brand-900 transition-colors">
            Choose your trade app
          </a>
          <a href="/features/" class="rounded-xl border border-ink-300 bg-white px-5 py-3 font-medium text-ink-800 hover:border-brand-400 hover:text-brand-700 transition-colors">
            See the features
          </a>
        </div>

        <!-- Trade colour chips -->
        <div class="mt-8 flex flex-wrap items-center gap-2 text-sm text-ink-500">
          <span class="text-ink-400">Built for</span>
          {trades.map((t) => (
            <span
              class="inline-flex items-center gap-1.5 rounded-full border border-ink-200 bg-white px-3 py-1 font-medium text-ink-700"
            >
              <span class="size-2.5 rounded-full" style={`background:${t.accent}`}></span>
              {t.trade}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TRADE GRID ============ -->
  <section id="trades" class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8 py-16 md:py-20 scroll-mt-20">
    <p class="text-sm font-medium uppercase tracking-wider text-brand-600">One platform, four apps</p>
    <h2 class="display mt-3 text-3xl md:text-4xl text-brand-950">Pick the Stock4 built for your trade.</h2>
    <p class="mt-4 max-w-2xl text-ink-600 leading-relaxed">
      Each trade gets its own app — its own name, its own colours, its own listing on the App Store
      and Google Play, and its own web address. Same powerful stock engine underneath; the app in
      front of your team speaks your trade.
    </p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {trades.map((t) => <TradeCard trade={t} />)}
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="border-y border-ink-200 bg-brand-950 text-white">
    <div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8 py-16 md:py-20">
      <p class="text-sm font-medium uppercase tracking-wider text-brand-300">The core loop</p>
      <h2 class="display mt-3 text-3xl md:text-4xl">Count it. Order it. Control it.</h2>
      <p class="mt-4 max-w-2xl text-brand-100 leading-relaxed">
        Stock4 closes the loop between what is on the shelf, what you need to buy, and what it costs —
        so you stop running out of stock and stop overpaying for it.
      </p>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {steps.map((s) => (
          <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
            <div class="flex items-center gap-3">
              <span class="inline-flex size-11 items-center justify-center rounded-xl bg-white/10 text-white">
                <Icon name={s.icon} class="h-6 w-6" />
              </span>
              <span class="text-sm font-semibold text-brand-300">{s.n}</span>
            </div>
            <h3 class="mt-4 text-xl font-semibold">{s.title}</h3>
            <p class="mt-2 text-brand-100 leading-relaxed">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FEATURE HIGHLIGHTS ============ -->
  <section class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8 py-16 md:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm font-medium uppercase tracking-wider text-brand-600">What you get</p>
        <h2 class="display mt-3 text-3xl md:text-4xl text-brand-950">Everything a trade store needs.</h2>
      </div>
      <a href="/features/" class="inline-flex text-sm font-medium text-brand-700 hover:underline">
        Explore every feature &rarr;
      </a>
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {homeFeatures.map((f) => <FeatureCard feature={f} />)}
    </div>
  </section>

  <!-- ============ MOBILE + WEB ============ -->
  <section class="border-t border-ink-200 bg-ink-50">
    <div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8 py-16 md:py-20 grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="text-sm font-medium uppercase tracking-wider text-brand-600">Office and floor</p>
        <h2 class="display mt-3 text-3xl md:text-4xl text-brand-950">A web portal and a mobile app, in sync.</h2>
        <p class="mt-4 text-ink-600 leading-relaxed">
          Managers work from the full web portal in the office. The team runs stock takes, van checks
          and requests from a native iOS and Android app on the floor and in the van. It is the same
          live data — a count on a phone shows up in the office the moment it is saved.
        </p>
        <ul class="mt-6 space-y-3">
          {['Native iOS and Android apps for every trade', 'Barcode scanning with the phone camera', 'Works for the office, the store and the van'].map((t) => (
            <li class="flex items-start gap-3 text-ink-700">
              <span class="mt-0.5 text-brand-700"><Icon name="check-circle" class="h-5 w-5" /></span>
              <span>{t}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="grid grid-cols-2 gap-4">
        {trades.map((t) => (
          <div
            class="flex items-center gap-3 rounded-2xl border border-ink-200 bg-white p-4"
          >
            <img src={t.icon} alt={`${t.name} app icon`} width="44" height="44" class="h-11 w-11 rounded-xl shadow-sm" loading="lazy" />
            <div class="min-w-0">
              <p class="truncate text-sm font-semibold text-ink-900">{t.name}</p>
              <p class="text-xs text-ink-500">iOS · Android · Web</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="mx-auto max-w-3xl px-5 sm:px-6 lg:px-8 py-16 md:py-20">
    <p class="text-sm font-medium uppercase tracking-wider text-brand-600">Questions</p>
    <h2 class="display mt-3 text-3xl md:text-4xl text-brand-950">Good to know.</h2>
    <div class="mt-8 divide-y divide-ink-200 border-t border-ink-200">
      {faqs.map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-medium text-ink-900">
            {f.q}
            <span class="text-brand-500 transition-transform group-open:rotate-45 text-2xl leading-none">+</span>
          </summary>
          <p class="mt-3 text-ink-600 leading-relaxed">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ============ CTA BAND ============ -->
  <section class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8 py-16">
    <div class="relative overflow-hidden rounded-3xl bg-brand-900 p-8 text-white md:p-14">
      <div class="absolute -top-20 -left-20 h-72 w-72 rounded-full bg-brand-500/30 blur-3xl"></div>
      <div class="absolute -bottom-20 -right-20 h-72 w-72 rounded-full bg-brand-700/40 blur-3xl"></div>
      <div class="relative max-w-2xl">
        <p class="text-sm font-medium uppercase tracking-wider text-brand-300">Get started</p>
        <h2 class="display mt-3 text-3xl md:text-4xl">Get your stock under control.</h2>
        <p class="mt-4 text-brand-100 leading-relaxed">
          Tell us your trade and team size and we will set up your Stock4 account, load your
          suppliers and stock, and get your team onto the web portal and mobile app.
        </p>
        <a href="/contact/" class="mt-6 inline-block rounded-xl bg-white px-5 py-3 font-semibold text-brand-900 hover:bg-brand-100 transition-colors">
          Get a demo &rarr;
        </a>
      </div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(productLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Base>
