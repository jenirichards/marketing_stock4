---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, trades } from '../data/site';

const title = `Contact — ${site.name}`;
const description =
  'Get a Stock4 demo or ask a question. Tell us your trade and team size and we’ll set up your account with your suppliers and stock loaded.';

const subject = encodeURIComponent('Stock4 demo enquiry');
const body = encodeURIComponent(
  'Hi Stock4 team,\n\nWe would like a demo. A few details:\n\n- Trade (glazing / building / plumbing / electrics):\n- Company name:\n- Number of users:\n- Number of sites / vans:\n\nThanks,',
);
const mailto = `mailto:${site.email}?subject=${subject}&body=${body}`;
---

<Base title={title} description={description}>
  <section class="mx-auto max-w-4xl px-5 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="text-sm font-medium uppercase tracking-wider text-brand-600">Contact</p>
    <h1 class="display mt-3 text-4xl md:text-5xl text-brand-950">Let’s get your stock under control.</h1>
    <p class="mt-5 max-w-2xl text-lg text-ink-600 leading-relaxed">
      Tell us your trade and team size and we’ll walk you through Stock4, set up your account, and
      load your suppliers and stock so you can see it working on your own numbers.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <a
        href={mailto}
        class="flex flex-col rounded-2xl border border-ink-200 bg-white p-7 hover:border-brand-300 hover:shadow-md transition-all"
      >
        <span class="inline-flex size-11 items-center justify-center rounded-xl bg-brand-100 text-brand-800">
          <Icon name="send" class="h-6 w-6" />
        </span>
        <h2 class="mt-4 text-xl font-semibold text-ink-900">Email us</h2>
        <p class="mt-2 text-ink-600 leading-relaxed">
          The fastest way to reach us. We’ll reply with next steps and a time for a demo.
        </p>
        <span class="mt-4 font-medium text-brand-700">{site.email} &rarr;</span>
      </a>

      <div class="flex flex-col rounded-2xl border border-ink-200 bg-white p-7">
        <span class="inline-flex size-11 items-center justify-center rounded-xl bg-brand-100 text-brand-800">
          <Icon name="mobile" class="h-6 w-6" />
        </span>
        <h2 class="mt-4 text-xl font-semibold text-ink-900">Already know your trade?</h2>
        <p class="mt-2 text-ink-600 leading-relaxed">
          Head straight to the app built for you.
        </p>
        <ul class="mt-4 space-y-2">
          {trades.map((t) => (
            <li>
              <a href={t.webUrl} class="inline-flex items-center gap-2 text-sm font-medium text-ink-800 hover:text-brand-700">
                <span class="size-2.5 rounded-full" style={`background:${t.accent}`}></span>
                {t.name} &rarr;
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="mt-10 text-sm text-ink-500">
      Stock4 is a product of {site.studio}, trading name of {site.company}.
    </p>
  </section>
</Base>
