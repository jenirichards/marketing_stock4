---
import { gaMeasurementId } from '../data/site';

// Cookie consent, and the only thing that loads Google Analytics.
//
// Ported from the Freehold site, which is the canonical copy: if this behaviour
// needs changing, change it there and bring the change across all five sites,
// because an estate where one site asks and another does not is how we ended up
// here. Until this landed, this site dropped gtag.js on every visitor.
// Analytics cookies are the thing UK PECR wants consent for, so gtag is loaded
// on Accept and never before.
//
// The key is per-site on purpose. localStorage is per-origin, so a choice made
// on harbour-sw.co.uk cannot be read by stock4.co.uk anyway; naming the key after the
// site keeps that honest and stops a shared name implying otherwise.
//
// Strictly-necessary cookies are not covered by this and are not set here:
// this site has no sign-in and sets nothing of its own.
const STORAGE_KEY = 'stock4_consent_v1';
---

<div
  id="consent-banner"
  hidden
  class="fixed inset-x-0 bottom-0 z-50 border-t border-ink-200 bg-white/95 backdrop-blur"
  role="dialog"
  aria-live="polite"
  aria-label="Cookie choices"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-5 sm:px-6 lg:px-8 md:flex-row md:items-center md:justify-between">
    <p class="m-0 text-sm text-ink-600">
      We would like to use Google Analytics to count visits and see which pages
      are useful. Nothing is loaded unless you say yes, and we do not use it to
      identify you.
    </p>
    <div class="flex shrink-0 gap-3">
      <button
        type="button"
        data-consent="rejected"
        class="rounded-lg border border-ink-300 px-4 py-2 text-sm font-medium text-ink-700 transition-colors hover:bg-ink-50"
      >
        No thanks
      </button>
      <button
        type="button"
        data-consent="accepted"
        class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-700"
      >
        Accept
      </button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ STORAGE_KEY, gaMeasurementId }}>
  (function () {
    var banner = document.getElementById('consent-banner');
    var loaded = false;

    function read() {
      try {
        return window.localStorage.getItem(STORAGE_KEY);
      } catch (e) {
        // Private mode or storage disabled. Treat as undecided and do not
        // load anything; asking again next visit is the safe failure.
        return null;
      }
    }

    function write(value) {
      try {
        window.localStorage.setItem(STORAGE_KEY, value);
      } catch (e) {
        /* best effort */
      }
    }

    function loadAnalytics() {
      if (loaded || !gaMeasurementId) return;
      loaded = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.gtag('js', new Date());
      window.gtag('config', gaMeasurementId, { anonymize_ip: true });
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaMeasurementId;
      document.head.appendChild(s);
    }

    function decide(value) {
      write(value);
      if (banner) banner.hidden = true;
      if (value === 'accepted') loadAnalytics();
    }

    var decision = read();
    if (decision === 'accepted') loadAnalytics();
    else if (decision !== 'rejected' && banner) banner.hidden = false;

    if (banner) {
      banner.querySelectorAll('[data-consent]').forEach(function (b) {
        b.addEventListener('click', function () {
          decide(b.getAttribute('data-consent'));
        });
      });
    }

    // The footer's "Cookie preferences" link asks again.
    document.querySelectorAll('[data-consent-reopen]').forEach(function (el) {
      el.addEventListener('click', function (ev) {
        ev.preventDefault();
        if (banner) banner.hidden = false;
      });
    });
  })();
</script>
